@page "/"
@using Advanced_TODO_list.Models
@using System.Text.Json

<PageTitle>Advanced TODO Full</PageTitle>

<div class="card mb-4 shadow-sm">
    <div class="card-body bg-light">
        <h5 class="card-title">Мої списки:</h5>
        <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
            @foreach (var list in allLists)
            {
                <button @onclick="() => currentList = list"
                        class="btn @(currentList == list ? "btn-primary" : "btn-outline-primary")">
                    @list.Name
                </button>
            }
            <button @onclick="CreateNewList" class="btn btn-success">+ Новий список</button>
        </div>

        <div class="mt-3 p-2 border rounded bg-white">
            <h6>Імпорт / Експорт (JSON):</h6>
            <div class="d-flex gap-2">
                <textarea @bind="jsonData" class="form-control form-control-sm" placeholder="Вставте JSON сюди для імпорту"></textarea>
                <div class="d-flex flex-column gap-1">
                    <button class="btn btn-secondary btn-sm" @onclick="ExportData">Експорт</button>
                    <button class="btn btn-warning btn-sm" @onclick="ImportData">Імпорт</button>
                </div>
            </div>
        </div>
    </div>
</div>

@if (currentList != null)
{
    <div class="card shadow">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h3 class="mb-0">@currentList.Name</h3>

            <div class="d-flex gap-3 bg-secondary p-2 rounded" style="font-size: 0.8rem;">
                <label><input type="checkbox" @bind="hideDone" /> Сховати зроблені</label>
                <label><input type="checkbox" @bind="hideNotDone" /> Сховати не зроблені</label>
            </div>
        </div>

        <div class="card-body">
            <div class="input-group mb-3">
                <input @bind="newTaskTitle" class="form-control" placeholder="Що потрібно зробити?" />
                <button @onclick="AddTask" class="btn btn-primary">Додати</button>
            </div>

            <ul class="list-group">
                @foreach (var item in currentList.Items)
                {
                    if (hideDone && item.IsDone) continue;
                    if (hideNotDone && !item.IsDone) continue;

                    <li class="list-group-item d-flex align-items-center">
                        <input type="checkbox" @bind="item.IsDone" class="form-check-input me-3" />
                        <span style="@(item.IsDone ? "text-decoration: line-through; color: gray;" : "")">
                            @item.Title
                        </span>
                    </li>
                }
            </ul>
        </div>
    </div>
}

@code {
    private List<TodoList> allLists = new() { new TodoList { Name = "Основний список" } };
    private TodoList? currentList;
    private string newTaskTitle = "";

    private bool hideDone = false;
    private bool hideNotDone = false;

    private string jsonData = "";

    protected override void OnInitialized() => currentList = allLists.First();

    private void AddTask()
    {
        if (!string.IsNullOrWhiteSpace(newTaskTitle) && currentList != null)
        {
            currentList.Items.Add(new TodoItem { Title = newTaskTitle });
            newTaskTitle = "";
        }
    }

    private void CreateNewList()
    {
        var newList = new TodoList { Name = $"Список #{allLists.Count + 1}" };
        allLists.Add(newList);
        currentList = newList;
    }

    private void ExportData()
    {
        jsonData = JsonSerializer.Serialize(allLists);
    }

    private void ImportData()
    {
        try
        {
            var imported = JsonSerializer.Deserialize<List<TodoList>>(jsonData);
            if (imported != null)
            {
                allLists = imported;
                currentList = allLists.FirstOrDefault();
            }
        }
        catch { /*помилка формату JSON */ }
    }
}